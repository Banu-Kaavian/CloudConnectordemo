{
 "meta": {
  "creator": "cds-dk 8.8.1"
 },
 "$version": "2.0",
 "definitions": {
  "smetadata": {
   "kind": "service",
   "@cds.external": true,
   "@m.IsDefaultEntityContainer": "true",
   "@sap.message.scope.supported": "true",
   "@sap.supported.formats": "atom json xlsx"
  },
  "smetadata.Programs": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "@sap.creatable": "false",
   "@sap.updatable": "false",
   "@sap.deletable": "false",
   "@sap.content.version": "1",
   "@sap.label": "Z Report and Module Pool Programs",
   "elements": {
    "ProgramName": {
     "key": true,
     "type": "cds.String",
     "length": 40,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Object Name",
     "@sap.quickinfo": "Object Name in Object Directory",
     "notNull": true
    },
    "Author": {
     "type": "cds.String",
     "length": 12,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Person Responsible",
     "@sap.quickinfo": "Person Responsible for a Repository Object"
    }
   }
  }
 }
}