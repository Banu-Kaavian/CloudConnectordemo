<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="ns.abapprograms.controller.View1">

    <VBox id="_IDGenVBox">
        <Label id="_IDGenLabel1" text="Select a Program"/>
        <ComboBox id="programDropdown"
            items="{mainmodel>/Programs}"
            selectionChange=".onProgramSelect"
            editable="true">
            <core:ListItem id="_IDGenListItem" key="{mainmodel>ProgramName}" text="{mainmodel>ProgramName}" />
        </ComboBox>

        <Label id="_IDGenLabel2" text="Selected Program Name"/>
        <TextArea id="programCode" rows="10" width="100%" editable="false"/>
    </VBox>
</mvc:View>
