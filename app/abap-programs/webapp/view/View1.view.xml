<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="ns.abapprograms.controller.View1">
    
    <VBox id="_IDGenVBox">
        <Label id="_IDGenLabel" text="Select a Program"/>
        <ComboBox id="programDropdown"
            items="{mainmodel>/Programs}"
            selectionChange=".onProgramSelect">
            <core:Item id="_IDGenItem1" key="{mainmodel>ProgramName}" text="{mainmodel>ProgramName}" />
        </ComboBox>

        <Label id="_IDGenLabel1" text="Program Source Code"/>
        <TextArea id="programCode" rows="1000" width="100%" editable="false"/>
    </VBox>
</mvc:View>
